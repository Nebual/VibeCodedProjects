diff --git a/pyproject.toml b/pyproject.toml
index a52fa6f..9a02e1d 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -82,3 +82,16 @@ notebooks = [
     "plotly>=5.20",
     "jupyterlab>=4.0",
 ]
+
+# PyPI's default `torch` wheel now bundles whatever CUDA build is current (cu130 as of
+# 2.13.0), and each new CUDA major drops the oldest GPU architectures — cu130 dropped
+# Pascal (sm_60/61/62), breaking e.g. the GTX 10-series. Pin Linux installs to the cu126
+# index instead, which still ships Pascal kernels; Windows/macOS installs are unaffected
+# (macOS has no CUDA wheels at all, so it must keep resolving from the default index).
+[tool.uv.sources]
+torch = [{ index = "pytorch-cu126", marker = "sys_platform == 'linux'" }]
+
+[[tool.uv.index]]
+name = "pytorch-cu126"
+url = "https://download.pytorch.org/whl/cu126"
+explicit = true
