--- a/muscriptor/utils/beats.py
+++ b/muscriptor/utils/beats.py
@@ -51,7 +51,24 @@ Onsets = Sequence[float] | np.ndarray
 
 
 class BeatDetectionError(RuntimeError):
-    """No usable beat grid in the audio (too short, or no constant tempo)."""
+    """No usable beat grid in the audio (too short, or no constant tempo).
+
+    Carries the tempo that *was* fitted, when there was one. A recording whose beats
+    wander too much for a constant grid still has a best-fit BPM, and that number is
+    a far better starting point for a caller than a 120 placeholder — but it used to
+    survive only inside the message text, where nothing could reach it.
+    """
+
+    def __init__(
+        self,
+        message: str,
+        *,
+        bpm: float | None = None,
+        residual: float | None = None,
+    ):
+        super().__init__(message)
+        self.bpm = bpm
+        self.residual = residual
 
 
 # What to do when the tempo can't be detected: True raises, False doesn't even
@@ -351,7 +368,9 @@ def detect_grid(
     if residual > MAX_TEMPO_RESIDUAL * beat_seconds:
         raise BeatDetectionError(
             f"The recording has no fixed tempo (beats deviate {residual * 1000:.0f} ms "
-            f"RMS from a constant {bpm:.1f} BPM)"
+            f"RMS from a constant {bpm:.1f} BPM)",
+            bpm=bpm,
+            residual=residual,
         )
 
     beats_per_bar = infer_beats_per_bar(beats, downbeats)
