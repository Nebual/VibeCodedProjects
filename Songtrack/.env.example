PORT=8193
NITRO_PORT=8193

# Required by nuxt-auth-utils to seal session cookies (32+ chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NUXT_SESSION_PASSWORD=

NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Directory for the SQLite DB and audio files (mounted volume in production).
DATA_DIR=data

# Auto-promoted to admin + approved on first Google sign-in.
SONGTRACK_ADMIN_EMAIL=
