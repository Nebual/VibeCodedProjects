PORT=8193
NITRO_PORT=8193

# Required by nuxt-auth-utils to seal session cookies (32+ chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NUXT_SESSION_PASSWORD=

NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Directory for the SQLite DB and audio files (mounted volume in production).
DATA_DIR=data

# Auto-promoted to admin + approved on first Google sign-in.
SONGTRACK_ADMIN_EMAIL=

# Audio → MIDI sidecar (see README). Unset in dev unless you're running the container;
# the transcription routes return a readable 503 rather than failing obscurely.
MIDI_WORKER_URL=
# Which model the CPU sidecar was launched with. Part of the transcription cache key.
MIDI_WORKER_MODEL=medium

# Optional GPU tier (docker compose --profile gpu up -d). Leave unset unless it's running:
# when it is set, each transcription probes its /health (1.5s timeout, verdict cached 30s) and
# falls back to the CPU sidecar whenever it doesn't answer.
MIDI_WORKER_GPU_URL=
MIDI_WORKER_GPU_MODEL=large
