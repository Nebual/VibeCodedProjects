{
  "name": "songtrack",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "gman-deploy": "git push && ssh gman@gman '/servers/songtrack/Songtrack/bin/gman-deploy.sh'",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "import": "tsx --env-file=.env scripts/import.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.44.5",
    "nanoid": "^5.1.5",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "^0.5.20",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "wavesurfer.js": "^7.11.0"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.1.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.16",
    "@types/better-sqlite3": "^7.6.13",
    "@vite-pwa/nuxt": "^1.1.1",
    "daisyui": "^5.1.29",
    "drizzle-kit": "^0.31.5",
    "h3": "2.0.1-rc.29",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.10"
  }
}
