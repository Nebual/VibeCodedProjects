# /mnt/servers is a CIFS share: symlinks and cross-device hardlinks are unavailable,
# so use a flat node_modules and copy packages in from the store.
node-linker=hoisted
package-import-method=copy

# Re-checking the lockfile before every `pnpm dev` means a full store scan over the
# network mount, which takes minutes. Run `pnpm install` yourself after changing deps.
verify-deps-before-run=false
