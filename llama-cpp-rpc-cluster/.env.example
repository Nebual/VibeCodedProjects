# Copy to .env on each machine and adjust.

# --- primary node only ---
MODELS_DIR=./models
MODEL_FILE=your-model.gguf
SERVER_PORT=8080
N_GPU_LAYERS=999
# Comma-separated host:port list of every worker's ggml-rpc-server.
RPC_HOSTS=192.168.0.162:50052

# --- worker node only ---
RPC_PORT=50052

# --- both nodes ---
# Current hardware is RTX 30xx / A100 = 86. Reference for other archs if this
# ever changes (comma-separate multiple, e.g. "80;86" for a mixed pair):
#   75  = Turing      (RTX 20xx, GTX 16xx)
#   80  = Ampere       (A100)
#   86  = Ampere       (RTX 30xx)
#   89  = Ada Lovelace (RTX 40xx)
#   90  = Hopper       (H100)
CUDA_ARCHITECTURES=86
