# Session cookie encryption key. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 32
NUXT_SESSION_PASSWORD=replace-me-with-a-random-32-plus-char-string

# Google OAuth credentials, from https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must be:  <origin>/auth/google
#   e.g. http://localhost:3000/auth/google
#        https://fittown.example.com/auth/google
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Optional: pin the OAuth callback URL instead of deriving it from the request.
# Behind a TLS-terminating reverse proxy the app is spoken to over plain HTTP,
# so unless the proxy sends `X-Forwarded-Proto: https` it builds an http://
# callback and Google rejects it with redirect_uri_mismatch. Fixing the proxy
# is the better answer; this is the escape hatch.
# NUXT_OAUTH_GOOGLE_REDIRECT_URL=https://fittown.example.com/auth/google

# Optional: restrict sign-in to specific Google accounts (comma-separated).
# Leave unset to allow any Google account — only sensible on a private network.
# FITTOWN_ALLOWED_EMAILS=you@gmail.com,partner@gmail.com

# Optional: where the SQLite database lives. Defaults to ./data/fittown.db
# FITTOWN_DB_PATH=/var/lib/fittown/fittown.db

# Dev only: enables the no-password sign-in button on /login.
# Ignored entirely in production builds.
FITTOWN_DEV_LOGIN=1

# Optional: base URL of a llama-server instance running a vision model (e.g.
# Qwen3-VL) for the "scan a photo" recipe importer. Leave unset to disable it —
# the import page simply won't offer the photo tab.
#   Dev example (LAN box):  http://192.168.0.162:8191
#   Prod example (same box as Fittown): http://localhost:8191
# NUXT_RECIPE_OCR_BASE_URL=

# Optional: model name sent in chat completion requests. llama-server ignores
# it against whatever it actually has loaded, but the OpenAI-style API
# requires the field to be present. Only change this if you've renamed it.
# NUXT_RECIPE_OCR_MODEL=qwen3-vl
