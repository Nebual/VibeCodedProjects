# Session cookie encryption key. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 32
NUXT_SESSION_PASSWORD=replace-me-with-a-random-32-plus-char-string

# Google OAuth credentials, from https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must be:  <origin>/auth/google
#   e.g. http://localhost:3000/auth/google
#        https://fittown.example.com/auth/google
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Optional: restrict sign-in to specific Google accounts (comma-separated).
# Leave unset to allow any Google account — only sensible on a private network.
# FITTOWN_ALLOWED_EMAILS=you@gmail.com,partner@gmail.com

# Optional: where the SQLite database lives. Defaults to ./data/fittown.db
# FITTOWN_DB_PATH=/var/lib/fittown/fittown.db

# Dev only: enables the no-password sign-in button on /login.
# Ignored entirely in production builds.
FITTOWN_DEV_LOGIN=1
