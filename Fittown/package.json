{
  "name": "Fittown",
  "type": "module",
  "private": true,
  "//imports": "Mirrors the #shared alias Nuxt sets up, so the maintenance scripts in scripts/ can import the same modules the app does under plain `node` (which strips types but knows nothing about bundler aliases). Without this, scripts/recompute-recipes.mjs would need its own copy of the recipe maths.",
  "imports": {
    "#shared/*": "./shared/*.ts"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "nuxt prepare",
    "gman-deploy": "git push && ssh gman@gman '/servers/fittown/Fittown/bin/deploy-fittown.sh'"
  },
  "dependencies": {
    "barcode-detector": "^3.2.2",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "^0.5.30",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "zxing-wasm": "3.1.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "daisyui": "^5.7.17",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "vitest": "^4.1.10"
  }
}
