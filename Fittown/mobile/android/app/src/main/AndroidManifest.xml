<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Device pairing deep link (docs/samsung-health-sync.md §3):
              tapping fittown://pair?code=XXXXXXXX — e.g. from the code shown
              on the Settings page of a browser signed in to Fittown — opens
              this activity so the app can read the code straight out of the
              intent instead of the user typing it by hand. A custom scheme,
              not an App Link, so no android:autoVerify / assetlinks.json is
              needed — this is a self-hosted app the household installs by
              sideload, not one Android verifies ownership of a domain for.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fittown" android:host="pair" />
            </intent-filter>

        </activity>

        <!--
          Health Connect requires this exact pair — a plain activity for
          Android 13 and earlier, an alias with a different intent-filter for
          14+ — pointing at *some* screen explaining why the app wants health
          data. It's not a Play Store formality: the permission request
          itself doesn't work without it. docs/samsung-health-sync.md §6.
        -->
        <activity
            android:name=".HealthPermissionsRationaleActivity"
            android:exported="true"
            android:label="@string/title_activity_main">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".HealthPermissionsRationaleActivityAlias"
            android:exported="true"
            android:targetActivity=".HealthPermissionsRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Deliberately not READ_TOTAL_CALORIES_BURNED — that figure is active +
      BMR, and the calorie cascade (docs/samsung-health-sync.md §2.1) never
      uses it: it would double-count against the diary's own BMR-based
      budget. Only the three records HealthConnectSync.kt actually reads.
    -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
</manifest>
